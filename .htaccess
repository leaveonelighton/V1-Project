# Canonical URL redirects
RedirectMatch 301 ^/book\.html$ https://leaveonelighton.org/books.html
RedirectMatch 301 ^/books/?$ https://leaveonelighton.org/books.html
RedirectMatch 301 ^/when-does-a-second-chance-become-real\.html$ https://leaveonelighton.org/research/when-does-a-second-chance-become-real.html

# Compress text-based responses when the server module is available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml application/xhtml+xml image/svg+xml
</IfModule>

# Conservative browser caching. HTML stays revalidated; versionless assets get
# useful but deliberately modest lifetimes so production updates are not trapped
# behind long-lived caches.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/gif "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType font/woff "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Response hardening and canonical HTTP headers.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Initial HSTS ramp-up: HTTPS-only, apex host only, short lifetime while
  # production behavior is observed. Do not add includeSubDomains or preload
  # until every relevant subdomain and certificate path is explicitly verified.
  Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on'"

  # Defense-in-depth against injected script and untrusted resource loads.
  # Inline event-handler attributes are blocked outright. Stripe's embedded Buy
  # Button is the only third-party script/frame allowlist and is required by
  # Stripe's documented CSP guidance for the Keep the Light On checkout.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src https://js.stripe.com; form-action 'self'; script-src 'self' https://js.stripe.com; script-src-attr 'none'; connect-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(?:html?|xml|txt)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  <Files "community-light-starter-kit.html">
    Header set Link '<https://leaveonelighton.org/welcome-shelf/community-light-starter-kit.html>; rel="canonical"'
  </Files>
  <Files "foster-care-start-here.html">
    Header set Link '<https://leaveonelighton.org/welcome-shelf/foster-care-start-here.html>; rel="canonical"'
  </Files>
  <Files "one-light-at-work.html">
    Header set Link '<https://leaveonelighton.org/welcome-shelf/one-light-at-work.html>; rel="canonical"'
  </Files>
  <Files "one-meaningful-step.html">
    Header set Link '<https://leaveonelighton.org/welcome-shelf/one-meaningful-step.html>; rel="canonical"'
  </Files>
  <Files "reading-learning-questions.html">
    Header set Link '<https://leaveonelighton.org/welcome-shelf/reading-learning-questions.html>; rel="canonical"'
  </Files>
  <Files "resource-navigation-notes.html">
    Header set Link '<https://leaveonelighton.org/welcome-shelf/resource-navigation-notes.html>; rel="canonical"'
  </Files>
  <Files "story-preservation-workbook.html">
    Header set Link '<https://leaveonelighton.org/welcome-shelf/story-preservation-workbook.html>; rel="canonical"'
  </Files>
</IfModule>
